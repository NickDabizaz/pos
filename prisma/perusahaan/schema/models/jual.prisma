/// Penjualan (transaksi keluar barang kepada Customer). status: "S" = tersimpan, "D" = dibatalkan.
/// tgltrans + idlokasi mengikat Penjualan ke Shift-nya (lihat ADR 0004).
model jual {
  idjual         Int      @id @default(autoincrement())
  kodejual       String   @unique @db.VarChar(30)
  tgltrans       DateTime @db.Date
  jenistransaksi String   @db.VarChar(10)
  idcustomer     Int
  idlokasi       Int
  total          Decimal  @db.Decimal(14, 2)
  diskon         Decimal  @db.Decimal(14, 2)
  ppn            Decimal  @db.Decimal(14, 2)
  grandtotal     Decimal  @db.Decimal(14, 2)
  status         String   @default("S") @db.VarChar(1)
  alasanbatal    String?  @db.VarChar(255)

  customer customer  @relation(fields: [idcustomer], references: [idcustomer])
  lokasi   lokasi    @relation(fields: [idlokasi], references: [idlokasi])
  details  jualdtl[]
  bayar    bayar[]

  @@index([idcustomer], map: "idcustomer")
  @@index([idlokasi], map: "idlokasi")
}

model jualdtl {
  idjual   Int
  urutan   Int
  idbarang Int
  qty      Decimal @db.Decimal(14, 2)
  harga    Decimal @db.Decimal(14, 2)
  pakaippn String  @db.VarChar(10)
  diskon   Decimal @db.Decimal(14, 2)
  ppn      Decimal @db.Decimal(14, 2)
  subtotal Decimal @db.Decimal(14, 2)

  jual   jual   @relation(fields: [idjual], references: [idjual])
  barang barang @relation(fields: [idbarang], references: [idbarang])

  @@id([idjual, urutan])
  @@index([idbarang], map: "idbarang")
}

/// Rincian bagaimana satu Penjualan dilunasi.
model bayar {
  idbayar   Int     @id @default(autoincrement())
  idjual    Int
  tunai     Decimal @db.Decimal(14, 2)
  nontunai  Decimal @db.Decimal(14, 2)
  kembalian Decimal @db.Decimal(14, 2)

  jual jual @relation(fields: [idjual], references: [idjual])

  @@index([idjual], map: "idjual")
}
