/// Pencatatan debet-kredit per transaksi. idtrans polimorfik tanpa FK — jenistransaksi yang
/// menentukan tabel sumbernya. tgltrans + idlokasi disalin dari transaksi induk agar laporan
/// per periode bisa disusun tanpa join.
model jurnal {
  jenistransaksi String   @db.VarChar(15)
  idtrans        Int
  urutan         Int
  kodetrans      String   @db.VarChar(30)
  tgltrans       DateTime @db.Date
  idlokasi       Int
  saldo          String   @db.VarChar(6)
  amount         Decimal  @db.Decimal(14, 2)
  catatan        String   @db.VarChar(255)

  @@id([jenistransaksi, idtrans, urutan])
  @@index([tgltrans])
}
