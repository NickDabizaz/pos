/// Status Perusahaan: 0 = belum bayar (baru mendaftar, belum ada Subscription lunas), 1 = aktif.
model perusahaan {
  idperusahaan   Int      @id @default(autoincrement())
  kodeperusahaan String   @unique @db.VarChar(20)
  namaperusahaan String   @db.VarChar(100)
  namadatabase   String   @unique @db.VarChar(64)
  status         Int      @default(0) @db.SmallInt
  createdat      DateTime @default(now())

  subscriptions        subscription[]
  userperusahaans      userperusahaan[]
  usermenus            usermenu[]
  sessions             Session[]
  invitationperusahaan invitationperusahaan?
}

/// Status Subscription: 1 = aktif. Baris hanya dibuat setelah pembayaran dikonfirmasi lunas,
/// sehingga tidak ada kosakata pending/gagal di sini. `orderid` menyimpan order_id transaksi
/// Midtrans yang melunasi Subscription ini — dipakai untuk menolak notifikasi settlement duplikat
/// untuk order_id yang sama tanpa perlu tabel transaksi terpisah (lihat tiket 09).
model subscription {
  idsubscription  Int      @id @default(autoincrement())
  idperusahaan    Int
  orderid         String   @unique @db.VarChar(100)
  namapaket       String   @db.VarChar(100)
  hargapaket      Decimal  @db.Decimal(14, 2)
  masaberlakuhari Int
  tglmulai        DateTime @db.Date
  tglselesai      DateTime @db.Date
  status          Int      @default(1) @db.SmallInt
  createdat       DateTime @default(now())

  perusahaan perusahaan        @relation(fields: [idperusahaan], references: [idperusahaan])
  details    subscriptiondtl[]

  @@index([idperusahaan], map: "idperusahaan")
}

model subscriptiondtl {
  idsubscription Int
  urutan         Int
  keterangan     String  @db.VarChar(100)
  nominal        Decimal @db.Decimal(14, 2)

  subscription subscription @relation(fields: [idsubscription], references: [idsubscription])

  @@id([idsubscription, urutan])
}

/// Hak Menu: izin satu Pengguna atas satu Menu di dalam satu Perusahaan. Hanya berlaku
/// untuk karyawan; Owner melewatinya lewat isowner di userperusahaan. status: 0 = nonaktif, 1 = aktif.
model usermenu {
  iduser       String @db.VarChar(36)
  idperusahaan Int
  kodemenu     String @db.VarChar(10)
  status       Int    @default(1) @db.SmallInt

  user       User       @relation(fields: [iduser], references: [id], onDelete: Cascade)
  perusahaan perusahaan @relation(fields: [idperusahaan], references: [idperusahaan])
  menu       menu       @relation(fields: [kodemenu], references: [kodemenu])

  @@id([iduser, idperusahaan, kodemenu])
  @@index([kodemenu], map: "kodemenu")
}

/// Keanggotaan: kaitan antara satu Pengguna dan satu Perusahaan. isowner menandai Pengguna
/// yang mendaftarkan Perusahaan; Owner selalu punya akses penuh dan tidak tunduk pada Hak Menu.
model userperusahaan {
  iduser       String   @db.VarChar(36)
  idperusahaan Int
  isowner      Boolean  @default(false)
  createdat    DateTime @default(now())

  user       User       @relation(fields: [iduser], references: [id], onDelete: Cascade)
  perusahaan perusahaan @relation(fields: [idperusahaan], references: [idperusahaan])

  @@id([iduser, idperusahaan])
}

/// Link invitation Perusahaan: satu Perusahaan hanya punya satu link aktif — membuat link baru
/// menggantikan yang lama. Siapa pun yang membuka link ini jadi anggota non-Owner Perusahaan
/// tersebut; link tidak sekali pakai, berlaku sampai expiresat.
model invitationperusahaan {
  token        String   @id @db.VarChar(64)
  idperusahaan Int      @unique
  expiresat    DateTime
  createdat    DateTime @default(now())

  perusahaan perusahaan @relation(fields: [idperusahaan], references: [idperusahaan], onDelete: Cascade)
}
