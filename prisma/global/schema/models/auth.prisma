/// Empat tabel di bawah ini dikelola oleh Better Auth (lihat lib/auth.ts), bukan tabel
/// domain aplikasi — nama kolomnya mengikuti konvensi resmi library-nya, kecuali `iduser`
/// yang sengaja di-remap (lihat lib/auth.ts) supaya konsisten dengan FK Pengguna di tabel
/// lain (usermenu.iduser, userperusahaan.iduser). `id` milik User/Session/Account/
/// Verification sendiri tidak bisa di-remap — itu primary key bawaan Better Auth. `User.id`
/// bertipe `VarChar(36)`, sama seperti `usermenu.iduser`/`userperusahaan.iduser`, supaya
/// kedua tabel itu bisa punya FK sungguhan ke User (lihat perusahaan.prisma) — tanpa ini FK
/// tidak bisa dipasang karena tipe kolomnya tidak cocok.
///
/// Alur & relasinya:
///   User          satu Pengguna. `id`-nya = `iduser` di Session/Account, dan di
///                 usermenu/userperusahaan.
///   Session       satu sesi login aktif (satu browser/perangkat). Baris terhapus saat
///                 logout atau `expiresAt` lewat.
///   Account       satu metode login milik satu User. Login email+password (tiket 04):
///                 `providerId` = "credential", `password` simpan hash-nya. Login sosial
///                 nanti (Google dst, tiket 06): baris baru per provider, User & Session
///                 tidak berubah.
///   Verification  token sekali-pakai (verifikasi email, reset password) — dicari lewat
///                 `identifier` (biasanya email), tidak berelasi langsung ke User.
model User {
  id              String           @id @db.VarChar(36)
  name            String           @db.Text
  email           String
  emailVerified   Boolean          @default(false)
  image           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  userperusahaans userperusahaan[]
  usermenus       usermenu[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  iduser    String   @db.VarChar(36)
  user      User     @relation(fields: [iduser], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([iduser])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String    @db.Text
  providerId            String    @db.Text
  iduser                String    @db.VarChar(36)
  user                  User      @relation(fields: [iduser], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId(length: 191)])
  @@index([iduser])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}
